---
layout: null
---
{%- assign pages = site.pages | where_exp: "p", "p.name contains '.md'" -%}
[
{%- for p in pages -%}
{%- assign text = p.content | markdownify | strip_html | normalize_whitespace -%}
{
  "title": {{ p.title | default: p.url | jsonify }},
  "url": {{ p.url | relative_url | jsonify }},
  "lang": {% if p.name contains ".no." %}"nb"{% else %}"en"{% endif %},
  "text": {{ text | truncatewords: 1500 | jsonify }}
}{%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]
